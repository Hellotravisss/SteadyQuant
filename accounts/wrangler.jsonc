{
  "name": "lbs-accounts",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "routes": [
    {
      "pattern": "accounts.lowbattery.studio",
      "custom_domain": true
    }
  ],
  "vars": {
    "APPLE_TEAM_ID": "4SC6PB8SA2",
    "APPLE_KEY_ID": "CB8GFX9JK2",
    "APPLE_SERVICES_ID": "studio.lowbattery.auth"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lbs-accounts-db",
      "database_id": "7844b275-22ee-4fce-bd49-fc37f5e932d3"
    }
  ],
  "observability": {
    "enabled": true
  }
}
