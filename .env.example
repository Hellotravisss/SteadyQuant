# 本地开发用：复制为 .dev.vars（已 gitignore），填入你自己的值
# 生产环境一律用 `npx wrangler secret put <NAME>` 注入，绝不写进代码

TUSHARE_TOKEN=your_tushare_token_here        # tushare.pro 个人主页获取（A股基本面/PE 数据）
DEEPSEEK_API_KEY=sk-xxx                      # platform.deepseek.com（AI 报告/规划/裁决）
KIMI_API_KEY=sk-xxx                          # platform.moonshot.cn（空头律师 + 截图识别）
ANTHROPIC_API_KEY=sk-ant-xxx                 # console.anthropic.com（可选：对辩法官/兜底）
RESEND_API_KEY=re_xxx                        # resend.com（每日巡检邮件）
KRONOS_API_URL=https://xxx.hf.space          # 你自部署的 Kronos 推理服务
KRONOS_HF_TOKEN=hf_xxx                       # 可选：让 ZeroGPU 配额挂在你自己账号下

# 数据库 ID（wrangler.jsonc 引用，非机密但建议自建后替换成你自己的）
D1_APP_DATABASE_ID=your_app_db_id
D1_ACCOUNTS_DATABASE_ID=your_accounts_db_id
