{
  "name": "steadyquant",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS"
  },
  "routes": [
    {
      "pattern": "quant.lowbattery.studio",
      "custom_domain": true
    }
  ],
  "observability": {
    "enabled": true
  }
}
