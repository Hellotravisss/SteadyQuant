{
  "name": "steadyquant",
  "main": "src/worker.js",
  "compatibility_date": "2026-07-01",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // 先跑 worker 再回退静态资产：否则 quant→steady 的 301 对首页不生效（资产在边缘直出）
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "steady.lowbattery.studio",
      "custom_domain": true
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "steadyquant-db",
      "database_id": "c453b2a7-d508-4117-89a5-132d36efa506"
    },
    {
      "binding": "ACCOUNTS_DB",
      "database_name": "lbs-accounts-db",
      "database_id": "7844b275-22ee-4fce-bd49-fc37f5e932d3"
    }
  ],
  "observability": {
    "enabled": true
  }
}
